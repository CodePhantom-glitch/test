# GEMINI_API_KEY: Required for optional server-side AI strategy explanations and anomaly analysis.
# Injected at runtime by AI Studio from Secrets. Never expose to the frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the application.
APP_URL="http://localhost:3000"

# Cloud SQL / PostgreSQL Connection Variables (Object Method):
SQL_HOST="localhost"
SQL_DB_NAME="flashai_db"
SQL_USER="flashai_app_user"
SQL_PASSWORD="replace_with_app_password"
SQL_ADMIN_USER="flashai_admin_user"
SQL_ADMIN_PASSWORD="replace_with_admin_password"

# Public Read-Only Ethereum RPC / WebSocket Endpoints (Used in MONITORING mode only):
ETH_RPC_URL="https://ethereum-rpc.publicnode.com"
ETH_WS_URL="wss://ethereum-rpc.publicnode.com"

# SECURITY NOTICE:
# Live mainnet transaction execution is architecturally disabled.
# NEVER store or add private keys, seed phrases, or signing secrets in .env files.
